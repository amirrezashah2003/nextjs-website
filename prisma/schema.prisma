generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id       Int    @id @default(autoincrement())
  category String
  brand    String
  model    String
  name     String
  price    BigInt 
  info     String
  img      String

  cartItems CartItem[]
  orderItems OrderItem[]
}

model User {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  name      String?  
  email     String?  // جدید: برای پروفایل و فاکتور
  nationalId String? // جدید: کد ملی برای خریدهای اینترنتی
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart      Cart? 
  orders    Order[]  // رابطه با سفارش‌ها
  addresses Address[] // رابطه با آدرس‌های کاربر
}

model Otp {
  id        Int      @id @default(autoincrement())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ==================== مدل‌های سبد خرید ====================

model Cart {
  id        Int        @id @default(autoincrement())
  userId    Int?       @unique 
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  price     BigInt   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

// ==================== مدل‌های جدید پنل کاربری (سفارش‌ها و آدرس‌ها) ====================

model Order {
  id          Int         @id @default(autoincrement())
  userId      Int
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  totalPrice  BigInt      // مبلغ کل سفارش
  status      String      @default("PENDING") // وضعیت: PENDING (در حال بررسی), PROCESSING (آماده‌سازی), DELIVERED (تحویل داده شده), CANCELLED (لغو شده)
  addressText String      // آدرس متنی تحویل سفارش
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items       OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int
  price     BigInt   // قیمت محصول در زمان ثبت سفارش
}

model Address {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   @default("منزل") // مثلا منزل، محل کار
  city       String   // شهر
  street     String   // خیابان و پلاک
  postalCode String?  // کد پستی
  receiverName String? // نام گیرنده
  receiverPhone String? // تلفن گیرنده
  createdAt  DateTime @default(now())
}
