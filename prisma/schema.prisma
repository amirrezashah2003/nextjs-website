generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id       Int    @id @default(autoincrement()) // یا اگر id ها عددیِ دستی یا استرینگ هستند می‌تونه String بشه
  category String
  brand    String
  model    String
  name     String
  price    BigInt // چون قیمت‌ها بزرگ هستند (مثل ۶۵۹ میلیون تومان) از BigInt استفاده می‌کنیم
  info     String
  img      String
}